      const nextBtn = panel.querySelector('.next-day-btn');
      if (prevBtn && prevBtn.dataset.nav) {
        prevBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          selectedDay = parseInt(this.dataset.nav);
          renderCalendar();
          renderDayDetail();
        });
      }
      if (nextBtn && nextBtn.dataset.nav) {
        nextBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          selectedDay = parseInt(this.dataset.nav);
          renderCalendar();
          renderDayDetail();
        });
      }
    }

    // ===== RENDER: OVERALL PROGRESS =====
    function updateOverallProgress() {
      const pct = getOverallPct();
      document.getElementById('overall-pct').textContent = pct + '%';
      document.getElementById('overall-bar').style.width = pct + '%';

      // Domain pills
      const domains = ['D1','D2','D3','D4','D5'];
      const domainLabels = { D1:'D1: General Security', D2:'D2: Threats', D3:'D3: Architecture', D4:'D4: Operations', D5:'D5: Management' };
      domains.forEach(dom => {
        const days = getDomainDays(dom);
        const total = days.reduce((s,d) => s + d.tasks.length, 0);
        let done = 0;
        days.forEach(d => { for (let i=0;i<d.tasks.length;i++) if (isTaskChecked(d.day,i)) done++; });
        const pill = document.getElementById('dp-' + dom.toLowerCase());
        if (pill) {
          const dpct = total ? Math.round((done/total)*100) : 0;
          pill.textContent = domainLabels[dom] + ' · ' + dpct + '%';
        }
      });
    }

    // ===== RENDER: PROGRESS TAB =====
    function renderProgressTab() {
      const pct = getOverallPct();
      const circumference = 2 * Math.PI * 62;
      const offset = circumference - (pct / 100) * circumference;
      document.getElementById('progress-ring').setAttribute('stroke-dashoffset', offset);
      document.getElementById('circle-pct').textContent = pct + '%';

      document.getElementById('stat-total').textContent = getTotalTasks();
      document.getElementById('stat-done').textContent = getTotalCompleted();
      document.getElementById('streak-count').textContent = getStreak();

      // Questions + avg
      let totalQs = 0, totalScore = 0, scoreCount = 0;
      STUDY_DAYS.forEach(d => {
        const sc = state.scores['day' + d.day];
        if (sc) {
          totalQs += (parseInt(sc.qs) || 0);
          if (sc.score !== undefined && sc.score !== '' && sc.score !== null) { totalScore += parseFloat(sc.score); scoreCount++; }
        }
      });
      document.getElementById('stat-questions').textContent = totalQs;
      document.getElementById('stat-avg').textContent = scoreCount ? Math.round(totalScore / scoreCount) + '%' : '—';

      // Domain bars
      const domBars = document.getElementById('domain-bars');
      const domainInfo = [
        { id:'D1', name:'General Security', color:'#3b82f6' },
        { id:'D2', name:'Threats & Vulns', color:'#f97316' },
        { id:'D3', name:'Architecture', color:'#a855f7' },
        { id:'D4', name:'Operations', color:'#22c55e' },
        { id:'D5', name:'Management', color:'#14b8a6' }
      ];
      domBars.innerHTML = '';
      domainInfo.forEach(dom => {
        const days = getDomainDays(dom.id);
        const total = days.reduce((s,d) => s + d.tasks.length, 0);
        let done = 0;
        days.forEach(d => { for (let i=0;i<d.tasks.length;i++) if (isTaskChecked(d.day,i)) done++; });
        const dpct = total ? Math.round((done/total)*100) : 0;
        domBars.innerHTML +=
          '<div>' +
            '<div class="flex items-center justify-between mb-1">' +
              '<span class="text-xs font-medium" style="color:' + dom.color + '">' + dom.name + '</span>' +
              '<span class="text-xs text-navy-400 tabular-nums">' + dpct + '%</span>' +
            '</div>' +
            '<div class="w-full h-2 bg-navy-700 rounded-full overflow-hidden">' +
              '<div class="h-full rounded-full transition-all duration-500" style="width:' + dpct + '%;background:' + dom.color + '"></div>' +
            '</div>' +
          '</div>';
      });

      // Motivational message
      const msg = document.getElementById('motiv-msg');
      if (pct === 0) msg.textContent = "Welcome, Mohamed! Your Security+ journey starts today. Let's build momentum! 🚀";
      else if (pct < 20) msg.textContent = "Great start, Mohamed! You're laying the foundation. Keep checking off those tasks! 💪";
      else if (pct < 40) msg.textContent = "Nice momentum, Mohamed! You're building a solid knowledge base. Stay consistent! 📚";
      else if (pct < 60) msg.textContent = "You're past the halfway mark, Mohamed! The hardest part is behind you. Keep pushing! 🔥";
      else if (pct < 80) msg.textContent = "Amazing progress, Mohamed! You're in the home stretch. Your dedication is showing! ⭐";
      else if (pct < 100) msg.textContent = "Almost there, Mohamed! You've put in incredible work. The exam doesn't stand a chance! 🏆";
      else msg.textContent = "OUTSTANDING, Mohamed! 100% complete! You're fully prepared. Go ace that exam! 🎓🎉";

      // Score table
      const tbody = document.getElementById('score-table-body');
      tbody.innerHTML = '';
      STUDY_DAYS.forEach(d => {
        const sc = state.scores['day' + d.day] || {};
        tbody.innerHTML +=
          '<tr class="border-b border-navy-700/50">' +
            '<td class="py-2 pr-2 text-xs font-medium text-white">Day ' + d.day + '</td>' +
            '<td class="py-2 pr-2 text-xs text-navy-400">' + shortDate(d.date) + '</td>' +
            '<td class="py-2 pr-2 text-center"><input type="number" class="score-input text-xs qs-input" data-day="' + d.day + '" value="' + (sc.qs || '') + '" placeholder="0" min="0" /></td>' +
            '<td class="py-2 pr-2 text-center"><input type="number" class="score-input text-xs score-pct-input" data-day="' + d.day + '" value="' + (sc.score !== undefined ? sc.score : '') + '" placeholder="%" min="0" max="100" /></td>' +
            '<td class="py-2 text-center"><button class="save-score-btn text-xs text-electric hover:text-blue-300 font-medium" data-day="' + d.day + '">Save</button></td>' +
          '</tr>';
      });

      // Attach save handlers
      tbody.querySelectorAll('.save-score-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const day = parseInt(this.dataset.day);
          const row = this.closest('tr');
          const qs = row.querySelector('.qs-input').value;
          const score = row.querySelector('.score-pct-input').value;
          if (!state.scores) state.scores = {};
          state.scores['day' + day] = { qs: qs, score: score };
          saveState();
          renderProgressTab();
        });
      });
    }

    // ===== RENDER: REFERENCE TAB =====
    function renderReferenceTab(filter) {
      const container = document.getElementById('ref-cards');
      container.innerHTML = '';
      const q = (filter || '').toLowerCase();
      REF_CARDS.forEach((card, i) => {
        if (q && !card.title.toLowerCase().includes(q) && !card.content.toLowerCase().includes(q)) return;
        const div = document.createElement('div');
        div.className = 'rounded-xl overflow-hidden';
        div.innerHTML =
          '<button class="ref-accordion-btn w-full flex items-center justify-between px-4 py-3 text-left transition-colors hover:brightness-110" style="background:' + card.color + '20" data-idx="' + i + '">' +
            '<div class="flex items-center gap-2">' +
              '<div class="w-2 h-2 rounded-full" style="background:' + card.color + '"></div>' +
              '<span class="text-sm font-semibold" style="color:' + card.color + '">' + card.title + '</span>' +
            '</div>' +
            '<span class="text-xs text-navy-400">' + card.domain + '</span>' +
          '</button>' +
          '<div class="accordion-content bg-navy-800 px-4" id="ref-acc-' + i + '">' +
            '<div class="py-3 text-sm text-navy-300 leading-relaxed">' + card.content + '</div>' +
          '</div>';
        container.appendChild(div);
      });

      // Accordion handlers
      container.querySelectorAll('.ref-accordion-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const idx = this.dataset.idx;
          const content = document.getElementById('ref-acc-' + idx);
          content.classList.toggle('open');
        });
      });
    }

    // ===== COUNTDOWN =====
    function updateCountdown() {
      const examDate = new Date(getExamDate() + 'T09:00:00');
      const now = new Date('2026-08-07T10:47:00');
      const diff = Math.ceil((examDate - now) / (1000 * 60 * 60 * 24));
      const text = diff > 0 ? 'Exam in ' + diff + ' days' : (diff === 0 ? 'Exam day!' : 'Exam passed');
      const textM = diff > 0 ? diff + ' days' : (diff === 0 ? 'Today!' : 'Done');
      document.getElementById('countdown-text').textContent = text;
      document.getElementById('countdown-text-m').textContent = textM;
    }

    // ===== QUOTE =====
    function showQuote() {
      const dayOfYear = Math.floor((new Date('2026-08-07') - new Date('2026-01-01')) / 86400000);
      const idx = dayOfYear % QUOTES.length;
      document.getElementById('quote-text').textContent = QUOTES[idx];
    }

    // ===== TABS =====
    function switchTab(tab) {
      currentTab = tab;
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.getElementById('tab-' + tab).classList.remove('hidden');
      document.querySelectorAll('.tab-btn').forEach(btn => {
        if (btn.dataset.tab === tab) { btn.classList.remove('tab-inactive'); btn.classList.add('tab-active'); }
        else { btn.classList.remove('tab-active'); btn.classList.add('tab-inactive'); }
      });
      if (tab === 'progress') renderProgressTab();
      if (tab === 'reference') renderReferenceTab('');
    }

    // ===== INIT =====
    if (typeof lucide !== 'undefined' && typeof lucide.createIcons === 'function') {
      lucide.createIcons();
    }

    showQuote();
    updateCountdown();
    renderCalendar();
    renderDayDetail();
    updateOverallProgress();

    // Tab handlers
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', function() { switchTab(this.dataset.tab); });
    });

    // Search handler for reference tab
    document.getElementById('ref-search').addEventListener('input', function() {
      renderReferenceTab(this.value);
    });

    </script>
</body>
</html>
