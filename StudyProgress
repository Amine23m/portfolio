    // ===== HELPERS =====
    function formatDate(ds) {
      const d = new Date(ds + 'T12:00:00');
      return d.toLocaleDateString('en-US', { weekday:'short', month:'short', day:'numeric' });
    }

    function shortDate(ds) {
      const d = new Date(ds + 'T12:00:00');
      return d.toLocaleDateString('en-US', { month:'short', day:'numeric' });
    }

    function isToday(ds) {
      const today = new Date('2026-08-07T10:47:00');
      const d = new Date(ds + 'T12:00:00');
      return today.toDateString() === d.toDateString();
    }

    function isPast(ds) {
      const today = new Date('2026-08-07T10:47:00');
      const d = new Date(ds + 'T12:00:00');
      return d < today && !isToday(ds);
    }

    function getTaskKey(day, idx) { return 'd' + day + 't' + idx; }

    function isTaskChecked(day, idx) { return !!state.tasks[getTaskKey(day, idx)]; }

    function setTaskChecked(day, idx, val) {
      state.tasks[getTaskKey(day, idx)] = val;
      saveState();
    }

    function getDayTaskCount(day) {
      const d = STUDY_DAYS.find(x => x.day === day);
      return d ? d.tasks.length : 0;
    }

    function getDayCompletedCount(day) {
      const total = getDayTaskCount(day);
      let done = 0;
      for (let i = 0; i < total; i++) { if (isTaskChecked(day, i)) done++; }
      return done;
    }

    function isDayComplete(day) { return getDayCompletedCount(day) === getDayTaskCount(day) && getDayTaskCount(day) > 0; }

    function getTotalTasks() { return STUDY_DAYS.reduce((s, d) => s + d.tasks.length, 0); }

    function getTotalCompleted() {
      let c = 0;
      STUDY_DAYS.forEach(d => { for (let i = 0; i < d.tasks.length; i++) { if (isTaskChecked(d.day, i)) c++; } });
      return c;
    }

    function getOverallPct() {
      const t = getTotalTasks();
      return t ? Math.round((getTotalCompleted() / t) * 100) : 0;
    }

    function getStreak() {
      let streak = 0;
      for (let i = 0; i < STUDY_DAYS.length; i++) {
        const d = STUDY_DAYS[i];
        if (getDayCompletedCount(d.day) > 0) streak++;
        else break;
      }
      return streak;
    }

